# Compose project/network. Keep this value aligned with source/settings.env.
COMPOSE_PROJECT_NAME=vexa-meetings
IMAGE_TAG=v012

# Use alternate ports while the legacy Vexa stack is still running.
API_GATEWAY_HOST_PORT=18156
ADMIN_API_PORT=18157
MEETING_API_PORT=18180
RUNTIME_API_PORT=18190
POSTGRES_HOST_PORT=5558
MINIO_HOST_PORT=9100
MINIO_CONSOLE_HOST_PORT=9101

DB_NAME=vexa
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=vexa
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false

# Required non-placeholder secrets for a real deployment.
ADMIN_TOKEN=CHANGE_ME
INTERNAL_API_SECRET=CHANGE_ME
DOCKER_GID=0
LOG_LEVEL=info

# A published, compatible bot image. Do not use vexaai/vexa-bot:dev.
BROWSER_IMAGE=vexaai/vexa-bot:v012
TRANSCRIPTION_SERVICE_URL=
TRANSCRIPTION_SERVICE_TOKEN=
TRANSCRIPTION_MODEL=
TRANSCRIBE_ENABLED=true
RECORDING_ENABLED=false

# Configure a real HTTPS endpoint after the Meeting Intelligence backend is deployed.
VEXA_SYSTEM_WEBHOOK_URL=
VEXA_SYSTEM_WEBHOOK_SECRET=
VEXA_SYSTEM_WEBHOOK_ALLOW_PRIVATE_HTTP=false

