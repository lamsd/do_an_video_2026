# Single local runtime configuration for Meeting Intelligence and self-hosted Vexa.
# Copy to settings.env and replace every CHANGE_ME/empty secret.
# Keep this template in source control; never commit settings.env.
#
# IMPORTANT: POSTGRES_* belongs to the Meeting Intelligence application.
# DB_* belongs to the Vexa control plane. They must be different credentials.
APP_ENV=development
DASHBOARD_PORT=3000
API_PORT=8088

# Use a URL-safe password (letters, numbers, - and _), because Compose builds DATABASE_URL from it.
POSTGRES_DB=meeting
POSTGRES_USER=meeting
POSTGRES_PASSWORD=CHANGE_ME

# cloud is the recommended MVP mode. For self_host, set VEXA_API_BASE to the published Vexa gateway.
VEXA_MODE=self_host
# Docker DNS name from the meetings-only Vexa network.
VEXA_API_BASE=http://gateway:8000
VEXA_NETWORK=vexa-meetings_vexa
VEXA_API_KEY=
VEXA_WEBHOOK_SECRET=
VEXA_WEBHOOK_URL=

POLL_INTERVAL_SECONDS=3
ANALYSIS_DEBOUNCE_SECONDS=20
MODEL_VERSION=baseline-rules-v1
SENTIMENT_CONFIDENCE_THRESHOLD=0.60

# -----------------------------------------------------------------------------
# Self-hosted Vexa (consumed by scripts/vexa-selfhost.sh)
# -----------------------------------------------------------------------------
# Do not use Docker's reserved COMPOSE_PROJECT_NAME here: it would rename the
# application Compose project too. The Vexa helper maps this value only when it
# invokes the Vexa Compose file.
VEXA_COMPOSE_PROJECT_NAME=vexa-meetings
IMAGE_TAG=v012

# Use alternate host ports while a legacy Vexa stack is still running.
API_GATEWAY_HOST_PORT=18156
ADMIN_API_PORT=18157
MEETING_API_PORT=18180
RUNTIME_API_PORT=18190
POSTGRES_HOST_PORT=5558
MINIO_HOST_PORT=9100
MINIO_CONSOLE_HOST_PORT=9101

# Vexa-owned PostgreSQL and object storage. Do not reuse POSTGRES_PASSWORD.
DB_NAME=vexa
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=vexa
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false

# Required Vexa control-plane secrets.
ADMIN_TOKEN=CHANGE_ME
INTERNAL_API_SECRET=CHANGE_ME
DOCKER_GID=0
LOG_LEVEL=info
BROWSER_IMAGE=vexaai/vexa-bot:v012

# The base URL must be reachable FROM the Vexa meeting-api container.
# For the transcription container already published on this host, use the host's
# LAN IP, for example http://192.168.1.10:8083; never use 127.0.0.1 here.
TRANSCRIPTION_SERVICE_URL=
TRANSCRIPTION_SERVICE_TOKEN=
TRANSCRIPTION_MODEL=
TRANSCRIBE_ENABLED=true
RECORDING_ENABLED=false

# Leave URL empty until a public HTTPS endpoint for the application exists.
VEXA_SYSTEM_WEBHOOK_URL=
VEXA_SYSTEM_WEBHOOK_SECRET=
VEXA_SYSTEM_WEBHOOK_ALLOW_PRIVATE_HTTP=false
