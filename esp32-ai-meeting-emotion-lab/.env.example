# Development-only MQTT credentials. Replace all values before a real deployment.
POSTGRES_PASSWORD=meeting_agent_dev
# Docker Compose creates the backend PostgreSQL URL safely from POSTGRES_PASSWORD.
# Set DATABASE_URL only for direct (non-Docker) backend execution.
MQTT_HOST=broker
MQTT_PORT=1883
MQTT_BACKEND_PASSWORD=backend-dev-change-me
MQTT_EMPATHY_PASSWORD=empathy-dev-change-me
MQTT_CRITICAL_PASSWORD=critical-dev-change-me
MQTT_OPTIMISTIC_PASSWORD=optimistic-dev-change-me
MQTT_MODERATOR_PASSWORD=moderator-dev-change-me
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_TTS_MODEL=tts-1
EMOTION_MODEL_CHECKPOINT=
MEDIA_ROOT=/app/data/media
CORS_ORIGINS=http://localhost:8080
HEARTBEAT_TTL_SECONDS=15

