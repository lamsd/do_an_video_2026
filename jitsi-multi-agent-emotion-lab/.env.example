# Copy to .env. Do not commit real keys or recordings.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
DATABASE_URL=postgresql+psycopg://emotion_lab:emotion_lab@db:5432/emotion_lab
MEDIA_ROOT=/app/data/media
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Optional: a separately evaluated PyTorch checkpoint. Without it, acoustic emotion
# predictions intentionally remain unavailable.
EMOTION_CHECKPOINT=
EMOTION_MODEL_VERSION=

